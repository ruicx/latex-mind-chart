\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mindchart}[2026/11/09 v0.2.0 Modern Mind Map & Structural Charting Engine]

\RequirePackage{iftex}
\RequireLuaTeX
\RequirePackage{luatexbase}

\RequirePackage{tikz}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\usetikzlibrary{shapes.geometric,shapes.misc}

\newbox\mindchart@box
\newbox\mindchart@fitbox
\newdimen\mindchart@fitwidth
\newdimen\mindchart@fitheight

% Fit the completed picture, including strokes, labels, and all overlays.
\newcommand{\mindchartFitBegin}[2]{%
    \mindchart@fitwidth=#1\relax%
    \mindchart@fitheight=#2\relax%
    \setbox\mindchart@fitbox=\hbox\bgroup%
}
\newcommand{\mindchartFitEnd}{%
    \egroup%
    \directlua{mindchart.fit(\the\mindchart@fitbox, \number\mindchart@fitwidth, \number\mindchart@fitheight)}%
}
\newcommand{\mindchartUseFit}[1]{\scalebox{#1}{\usebox{\mindchart@fitbox}}}
\newcommand{\mindchartRecordFont}[1]{\directlua{mindchart.store_font(#1, \f@size)}}

% Link text keeps its ordinary measured dimensions. hyperref is opt-in.
\newcommand{\mindchartDestination}[2]{%
    \ifcsname hypertarget\endcsname\hypertarget{#1}{#2}\else#2\fi%
}
\newcommand{\mindchartLink}[3]{%
    \ifcsname hyperref\endcsname%
        \csname mindchart@link@#1\endcsname{#2}{#3}%
    \else%
        \PackageError{mindchart}{Links require hyperref}{Load hyperref in the document preamble.}%
    \fi%
}
\newcommand{\mindchart@link@href}[2]{\href{#1}{#2}}
\newcommand{\mindchart@link@ref}[2]{\hyperref[#1]{#2}}
\newcommand{\mindchart@link@target}[2]{\hyperlink{#1}{#2}}

\directlua{
    local f = kpse.find_file("mindchart.lua", "lua") or "./tex/mindchart.lua"
    dofile(f)
}

\def\mc@str@left{left}
\def\mc@str@right{right}

\newcommand{\mindchartMeasureItem}[2]{%
    \sbox\mindchart@box{#2}%
    \directlua{mindchart.store_dim(#1, \the\mindchart@box, false)}%
}

\newcommand{\mindchartMeasureMulti}[4]{%
    % #1: node id
    % #2: max_width (e.g. "4cm" or empty)
    % #3: align ("left", "center", "right")
    % #4: text
    \edef\mc@temp@mw{#2}%
    \ifx\mc@temp@mw\@empty%
        \def\mc@temp@al{#3}%
        \ifx\mc@temp@al\mc@str@left%
            \sbox\mindchart@box{\begin{tabular}{@{}l@{}}#4\end{tabular}}%
        \else%
            \ifx\mc@temp@al\mc@str@right%
                \sbox\mindchart@box{\begin{tabular}{@{}r@{}}#4\end{tabular}}%
            \else%
                \sbox\mindchart@box{\begin{tabular}{@{}c@{}}#4\end{tabular}}%
            \fi%
        \fi%
        \directlua{mindchart.store_dim(#1, \the\mindchart@box, true)}%
    \else%
        \sbox\mindchart@box{\parbox{#2}{%
            \noindent%
            \def\mc@temp@al{#3}%
            \ifx\mc@temp@al\mc@str@left\raggedright\else%
            \ifx\mc@temp@al\mc@str@right\raggedleft\else%
            \centering\fi\fi%
            #4\par%
        }}%
        \directlua{mindchart.store_dim(#1, \the\mindchart@box, true)}%
    \fi%
}

\newcommand{\mindchartFinishMeasure}{%
    \directlua{mindchart.render()}%
}

% User custom theme registration
\NewDocumentCommand{\mindchartDefineTheme}{ m m }{%
    \directlua{mindchart.define_theme([==[#1]==], [==[#2]==])}%
}

% PDF bookmark emission (interfacing with hyperref if present)
\newcommand{\mindchartEmitBookmark}[3]{%
    % #1: level (integer), #2: text, #3: dest_name
    \ifcsname pdfbookmark\endcsname%
        \pdfbookmark[#1]{#2}{#3}%
    \fi%
}

% Overlay markers for syntax completion inside environment
\NewDocumentCommand{\summary}{ O{} m m m }{}
\NewDocumentCommand{\rel}{ O{} m m m }{}
\ProvideDocumentCommand{\note}{ O{} m m }{}
\let\boundary\undefined
\NewDocumentCommand{\boundary}{ O{} m m m }{}

% Do not scan past the opening line for optional arguments: the next line
% must reach the Lua input callback before TeX tokenizes it.
\NewDocumentEnvironment{mindchart}{!O{}}{%
    \directlua{mindchart.start_env("\luaescapestring{\unexpanded{#1}}")}%
    \ignorespaces
}{%
    \directlua{mindchart.finish_env()}%
}
