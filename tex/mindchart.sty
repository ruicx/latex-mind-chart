\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mindchart}[2026/11/09 v0.2.0 Modern Mind Map & Structural Charting Engine]

\RequirePackage{iftex}
\RequireLuaTeX
\RequirePackage{luatexbase}

\RequirePackage{tikz}
\RequirePackage{xcolor}
\usetikzlibrary{shapes.geometric,shapes.misc}

\newbox\mindchart@box

\directlua{
    local f = kpse.find_file("mindchart.lua", "lua") or "./tex/mindchart.lua"
    dofile(f)
}

\def\mc@str@left{left}
\def\mc@str@right{right}

\newcommand{\mindchartMeasureItem}[2]{%
    \sbox\mindchart@box{#2}%
    \directlua{mindchart.store_dim(#1, \the\mindchart@box, false)}%
}

\newcommand{\mindchartMeasureMulti}[4]{%
    % #1: node id
    % #2: max_width (e.g. "4cm" or empty)
    % #3: align ("left", "center", "right")
    % #4: text
    \edef\mc@temp@mw{#2}%
    \ifx\mc@temp@mw\@empty%
        \def\mc@temp@al{#3}%
        \ifx\mc@temp@al\mc@str@left%
            \sbox\mindchart@box{\begin{tabular}{@{}l@{}}#4\end{tabular}}%
        \else%
            \ifx\mc@temp@al\mc@str@right%
                \sbox\mindchart@box{\begin{tabular}{@{}r@{}}#4\end{tabular}}%
            \else%
                \sbox\mindchart@box{\begin{tabular}{@{}c@{}}#4\end{tabular}}%
            \fi%
        \fi%
        \directlua{mindchart.store_dim(#1, \the\mindchart@box, true)}%
    \else%
        \sbox\mindchart@box{\parbox{#2}{%
            \noindent%
            \def\mc@temp@al{#3}%
            \ifx\mc@temp@al\mc@str@left\raggedright\else%
            \ifx\mc@temp@al\mc@str@right\raggedleft\else%
            \centering\fi\fi%
            #4\par%
        }}%
        \directlua{mindchart.store_dim(#1, \the\mindchart@box, true)}%
    \fi%
}

\newcommand{\mindchartFinishMeasure}{%
    \directlua{mindchart.render()}%
}

% User custom theme registration
\NewDocumentCommand{\mindchartDefineTheme}{ m m }{%
    \directlua{mindchart.define_theme([==[#1]==], [==[#2]==])}%
}

% PDF bookmark emission (interfacing with hyperref if present)
\newcommand{\mindchartEmitBookmark}[3]{%
    % #1: level (integer), #2: text, #3: dest_name
    \ifcsname pdfbookmark\endcsname%
        \pdfbookmark[#1]{#2}{#3}%
    \fi%
}

% Overlay markers for syntax completion inside environment
\NewDocumentCommand{\summary}{ O{} m m m }{}
\NewDocumentCommand{\rel}{ O{} m m m }{}
\let\boundary\undefined
\NewDocumentCommand{\boundary}{ O{} m m m }{}

\newenvironment{mindchart}[1][]{%
    \directlua{mindchart.start_env([==[#1]==])}%
}{%
    \directlua{mindchart.finish_env()}%
}
